{
  "mcpServers": {
    "continuum_map": {
      "command": "uv",
      "args": [
        "run",
        "--quiet",
        "--script",
        ".claude/mcp/map/server.py"
      ],
      "alwaysLoad": true
    },
    "reaper_docs": {
      "command": "uv",
      "args": [
        "run",
        "--quiet",
        "--script",
        ".claude/mcp/docs/server.py"
      ]
    },
    "continuum_tests": {
      "command": "uv",
      "args": [
        "run",
        "--quiet",
        "--script",
        ".claude/mcp/tests/server.py"
      ],
      "alwaysLoad": true
    },
    "reaper": {
      "command": "uv",
      "args": [
        "run",
        "--quiet",
        "--script",
        ".claude/mcp/reaper/server.py"
      ]
    }
  }
}
