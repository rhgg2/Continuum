{
  "permissions": {
    "allow": [
      "mcp__continuum_map__map_query",
      "mcp__continuum_tests__lua_test_run",
      "mcp__continuum_tests__lua_probe",
      "mcp__continuum_perturb__spec_perturb",
      "mcp__reaper_docs__reaper_doc_lookup",
      "mcp__reaper__reaper_eval",
      "mcp__reaper__reaper_reload",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git log *)",
      "Bash(python3 *)",
      "Bash(lua *)",
      "Skill(commit-finish)"
    ]
  },
  "enabledMcpjsonServers": [
    "continuum_map",
    "reaper_docs",
    "continuum_tests",
    "reaper",
    "continuum_perturb"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-env.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/commit-agent-allow.py\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-cleanup.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|mcp__patches__apply_patches|mcp__patches__retry_patches",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/map-regen.sh\"",
            "statusMessage": "Regenerating stale .map files..."
          }
        ]
      },
      {
        "matcher": "Edit|Write|mcp__patches__apply_patches|mcp__patches__retry_patches",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/luacheck-lint.sh\"",
            "statusMessage": "Linting edited Lua..."
          }
        ]
      }
    ]
  }
}
